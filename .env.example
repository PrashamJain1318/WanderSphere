# ==============================================================================
# WanderSphere — Environment Variables Template
# ==============================================================================
# Copy this file to .env in local development or set variables in your cloud provider.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# --- API Server Configuration ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- MongoDB Configuration ---
# Set to 'true' if the server must fail startup/readiness when MongoDB is unreachable.
# Default in development is 'false' to allow running without local database setup.
MONGODB_REQUIRED=false

# Connection string example for local MongoDB or Atlas:
# Local: mongodb://127.0.0.1:27017/wandersphere_dev
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wandersphere?retryWrites=true&w=majority
MONGODB_URI=

# Connection timeout in milliseconds
MONGODB_TIMEOUT_MS=5000

# --- Frontend (apps/web) Configuration ---
# Public URL of the backend API (accessible by client and server-side components)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web app environment
NEXT_PUBLIC_APP_ENV=development
